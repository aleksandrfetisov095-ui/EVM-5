#include <avr/io.h>
#include <avr/interrupt.h>

char count = 0;
char temp_b, temp_d;

ISR(PCINT0_vect) {
    char x = PINB;          // Чтение текущего состояния порта B
    char y = x ^ temp_b;    // XOR: маска изменившихся битов
    temp_b = x;             // Сохранение текущего состояния

    if (y & (1 << PB1)) {   // Проверяем, изменился ли именно PB1
        if (count & 0x80)   // Проверяем старший (7-й) бит счётчика
            PORTB |= (1 << PB5);    // PB5 = 1 (светодиод L горит)
        else
            PORTB &= ~(1 << PB5);   // PB5 = 0 (светодиод L погашен)
    }
}

ISR(PCINT2_vect) {
    char x = PIND;          // Чтение текущего состояния порта D
    char y = x ^ temp_d;    // XOR: маска изменившихся битов
    temp_d = x;             // Сохранение текущего состояния

    if (y & (1 << PD1)) {   // Проверяем, изменился ли именно PD1
        if (count & 0x80)   // Проверяем старший (7-й) бит счётчика
            PORTB |= (1 << PB5);    // PB5 = 1 (светодиод L горит)
        else
            PORTB &= ~(1 << PB5);   // PB5 = 0 (светодиод L погашен)
    }
}

int main(void) {
    temp_b = PINB;          // Инициализация предыдущего состояния порта B
    temp_d = PIND;          // Инициализация предыдущего состояния порта D

    DDRB = 0x20;            // PB5 — вывод (светодиод L)
    PORTB |= (1 << PB1);    // Подтяжка на PB1 (вход)
    PORTD |= (1 << PD1);    // Подтяжка на PD1 (вход)

    PCICR = (1 << PCIE0) | (1 << PCIE2);  // Разрешение групп 0 и 2
    PCMSK0 = (1 << PCINT1);                 // Только PCINT1 (PB1)
    PCMSK2 = (1 << PCINT17);                // Только PCINT17 (PD1)

    sei();                 

    while(1) {
        count++;           
    }
}
