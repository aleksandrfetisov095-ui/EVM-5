#include <avr/io.h>
#include <avr/interrupt.h>

char x, y, temp, count;

ISR(PCINT0_vect) {
    x = PINB;               // Чтение текущего состояния порта B
    y = x ^ temp;           // XOR: маска изменившихся битов
    temp = x;               // Сохранение текущего состояния
}

ISR(PCINT2_vect) {
    x = PIND;               // Чтение текущего состояния порта D
    y = x ^ temp;           // XOR: маска изменившихся битов
    temp = x;               // Сохранение текущего состояния
}

int main(void) {
    x = 0;
    PCICR = 0x07;           // Разрешение прерываний от групп 0, 1 и 2
    PCMSK0 = 0xFF;          // Разрешение прерываний от всех выводов порта B
    PCMSK2 = 0xFF;          // Разрешение прерываний от всех выводов порта D
    sei();                  // Глобальное разрешение прерываний

    while(1) {
        PORTC = count;      // Вывод счётчика в порт C
        count++;            // Инкремент счётчика
    }
}
