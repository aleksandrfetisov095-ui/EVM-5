.include "m328Pdef.inc"

.equ CLK=16000000
.equ BAUD=9600
.equ UBRR0_value=(CLK/(BAUD*16))-1

.org 0
jmp Reset

.org 0x0024
jmp priem

Reset:
    ldi r16, high(UBRR0_value)
    sts UBRR0H, r16
    ldi r16, low(UBRR0_value)
    sts UBRR0L, r16

    ldi r16, (1<<RXEN0)|(1<<RXCIE0)
    sts UCSR0B, r16
    ldi r16, (1<<UCSZ00)|(1<<UCSZ01)
    sts UCSR0C, r16

    ldi r16, 0x20
    out DDRB, r16
    cbi PORTB, 5

    sei

main:
    jmp main

priem:
    lds r16, UDR0
    cpi r16, 0x41
    brne gasit
    sbi PORTB, 5
    reti

gasit:
    cbi PORTB, 5
    reti
