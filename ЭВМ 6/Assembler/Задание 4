#include <avr/io.h>
#include <avr/interrupt.h>

uint8_t buf[4];
uint8_t state = 0;

ISR(USART_RX_vect) {
    char received = UDR0;
    
    if (received == '!') {
        state = 1;
    } else if (received == '.' && state == 5) {
        uint16_t sum = buf[0] + buf[1] + buf[2] + buf[3];
        
        UDR0 = '!';
        while (!(UCSR0A & (1<<UDRE0)));
        UDR0 = (sum >> 8) & 0xFF;
        while (!(UCSR0A & (1<<UDRE0)));
        UDR0 = sum & 0xFF;
        while (!(UCSR0A & (1<<UDRE0)));
        UDR0 = '.';
        
        state = 0;
    } else if (state >= 1 && state <= 4) {
        buf[state-1] = received;
        state++;
    }
}

int main(void) {
    UBRR0 = 103;
    UCSR0B = (1<<RXEN0) | (1<<TXEN0) | (1<<RXCIE0);
    UCSR0C = (1<<UCSZ01) | (1<<UCSZ00);
    sei();
    while(1) { }
}
