#include <avr/io.h>
#include <avr/interrupt.h>
#include <avr/pgmspace.h>

const char msg[] PROGMEM = "Atmega328P:ReadyToWork\n";
uint8_t idx = 0;

ISR(USART_TX_vect) {
    idx++;
    if (msg[idx] != '\0') {
        UDR0 = pgm_read_byte(&msg[idx]);
    } else {
        idx = 0;
        UDR0 = pgm_read_byte(&msg[0]);
    }
}

int main(void) {
    UBRR0 = 103;
    UCSR0B = (1<<TXEN0) | (1<<TXCIE0);
    UCSR0C = (1<<UCSZ01) | (1<<UCSZ00);
    UDR0 = pgm_read_byte(&msg[0]);
    sei();
    while(1) { }
}
